{
  "name": "dsh-remote",
  "version": "1.0.0",
  "description": "Remote SSH workspaces for DeepSeek Harness: native file and terminal tabs, agent tools with exit codes and compiler diagnostics, conflict-aware mirror sync, SSH configuration, port forwarding and audit logs.",
  "license": "MIT",
  "author": "flymysql <flyphp@outlook.com>",
  "readme": "README.md",
  "readmeFilename": "README.md",
  "homepage": "https://flymysql.github.io/dsh-remote/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flymysql/dsh-remote.git"
  },
  "bugs": {
    "url": "https://github.com/flymysql/dsh-remote/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "sandbox",
    "terminal",
    "dsh-plugin",
    "remote",
    "ssh",
    "tunnel",
    "plugin",
    "remote-workspace",
    "remote-development",
    "sftp"
  ],
  "type": "module",
  "main": "lib/boot.js",
  "exports": {
    ".": "./lib/boot.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "dsh": {
    "engines": {
      "dsh": ">=0.1.0-rc.6 <0.3.0 || >=0.1.5-0 <0.1.6 || >=0.1.7-0 <0.1.8 || >=0.2.0-0 <0.2.1 || >=0.2.2-0 <0.2.3"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-client-connection": ">=0.1.2-rc.1 <0.3.0 || >=0.1.5-0 <0.1.6 || >=0.1.7-0 <0.1.8 || >=0.2.0-0 <0.2.1 || >=0.2.2-0 <0.2.3",
    "@deepseek-ai/dsh-client-locale": ">=0.1.2-rc.1 <0.3.0 || >=0.1.5-0 <0.1.6 || >=0.1.7-0 <0.1.8 || >=0.2.0-0 <0.2.1 || >=0.2.2-0 <0.2.3",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.1.2-rc.1 <0.3.0 || >=0.1.5-0 <0.1.6 || >=0.1.7-0 <0.1.8 || >=0.2.0-0 <0.2.1 || >=0.2.2-0 <0.2.3",
    "@deepseek-ai/dsh-commands": ">=0.1.0-rc.6 <0.3.0 || >=0.1.5-0 <0.1.6 || >=0.1.7-0 <0.1.8 || >=0.2.0-0 <0.2.1 || >=0.2.2-0 <0.2.3",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.0-rc.6 <0.3.0 || >=0.1.5-0 <0.1.6 || >=0.1.7-0 <0.1.8 || >=0.2.0-0 <0.2.1 || >=0.2.2-0 <0.2.3",
    "@deepseek-ai/dsh-system-prompt": ">=0.1.0-rc.6 <0.3.0 || >=0.1.5-0 <0.1.6 || >=0.1.7-0 <0.1.8 || >=0.2.0-0 <0.2.1 || >=0.2.2-0 <0.2.3",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.6 <0.3.0 || >=0.1.5-0 <0.1.6 || >=0.1.7-0 <0.1.8 || >=0.2.0-0 <0.2.1 || >=0.2.2-0 <0.2.3"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-connection": {
      "optional": true
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.19.0",
    "iconv-lite": "^0.7.3",
    "ssh2": "^1.16.0",
    "yaml": "^2.9.1"
  },
  "bundleDependencies": [
    "ssh2",
    "asn1",
    "bcrypt-pbkdf",
    "tweetnacl"
  ],
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-llm": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-sandbox": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-scope": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-skill": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-system-prompt": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-timeout": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "^0.2.0-rc.2",
    "react": "^19.3.1",
    "semver": "^7.8.5"
  },
  "scripts": {
    "test": "node --import ./test/setup-telemetry-off.mjs --test --test-timeout=40000 --test-force-exit --test-concurrency=8",
    "test:coverage": "node scripts/coverage-union.mjs",
    "test:coverage:gate": "node scripts/coverage-union.mjs --gate 70 --file-gate 60"
  }
}
